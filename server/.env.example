# ---- GreenPulse server configuration (copy to .env) ----
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/greenpulse

# Long random string used to sign login cookies. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Set true only when the site is served over HTTPS directly by this server
COOKIE_SECURE=false

# Base URL encoded inside location QR codes, e.g. https://192.168.1.20:5173
# Leave empty to derive it from the browser address the admin is using.
PUBLIC_APP_URL=

# Optional: allow a separately hosted client (dev uses the Vite proxy, so not needed)
CLIENT_ORIGIN=

# Create demo users/standards/locations automatically when the database is empty
SEED_ON_START=true
